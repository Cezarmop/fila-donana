# Porta da API
PORT=3333
# Conexão com o PostgreSQL
DATABASE_URL=postgres://fila:fila@localhost:5432/fila_donana
# Senha do painel do recepcionista (troque!)
PAINEL_SENHA=troque-esta-senha
# Segredo para assinar o token de login do painel (gere uma string longa e aleatória)
JWT_SECRET=troque-este-segredo
# Endereço público do site (usado no QR code e nos links)
WEB_URL=http://localhost:5173
# Nome exibido nas mensagens
RESTAURANTE_NOME=Restaurante & Churrascaria Don'Ana

# Como avisar o cliente: "link" (gratuito, recepcionista envia pelo WhatsApp dele)
# ou "cloud_api" (WhatsApp Cloud API oficial da Meta, pago por mensagem)
WHATSAPP_MODO=link

# Só para WHATSAPP_MODO=cloud_api. CONFIRA na documentação atual da Meta:
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_API_VERSAO=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Nome e idioma do template aprovado no WhatsApp Manager
WHATSAPP_TEMPLATE=chamada_fila
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
